+#[cfg(test)]
+mod session_hidden_tests {
+    use super::*;
+
+    #[test]
+    fn only_markers_a_running_game_holds_hide_a_mod() {
+        let home = std::env::temp_dir().join(format!("hidden-native-mods-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&home);
+        let dir = home.join(SESSION_HIDDEN);
+        fs::create_dir_all(&dir).unwrap();
+        assert!(hidden(&home).is_empty());
+        let before = fingerprint(&home, None);
+        // The game's marker, held as a running game holds it.
+        let held = fs::File::create(dir.join("sunset.4242.lock")).unwrap();
+        held.try_lock().unwrap();
+        // A game that ended: its marker is free.
+        drop(fs::File::create(dir.join("other.17.lock")).unwrap());
+        // Not markers.
+        fs::write(dir.join("notes.txt"), "").unwrap();
+        fs::write(dir.join("bad.lock"), "").unwrap();
+        assert_eq!(hidden(&home).into_iter().collect::<Vec<_>>(), ["sunset"]);
+        assert!(!dir.join("other.17.lock").exists(), "a stale marker is removed");
+        assert_ne!(fingerprint(&home, None), before, "the Mods tab reads its list again");
+        // The game exits (or is killed): the system lets the lock go.
+        drop(held);
+        assert!(hidden(&home).is_empty());
+        assert_eq!(fingerprint(&home, None), before);
+        let _ = fs::remove_dir_all(&home);
+    }
+}
