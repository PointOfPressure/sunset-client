+/// Where a running game lists the native mods it hides from the launcher's lists for as long as
+/// it runs (Sunset's Panic): `<id>.<pid>.lock`, each held under an exclusive lock by that game
+/// process. The installation is untouched; only what the lists show changes.
+pub const SESSION_HIDDEN: &str = "horizon-session/hidden";
+
+/// The mod ids a game still running from `home` hides ([`SESSION_HIDDEN`]). A marker whose lock
+/// can be taken belongs to a game that has ended, however it ended (the system drops the lock
+/// with the process), so it hides nothing and is removed. Another instance's games have their own
+/// folder, so they hide nothing here.
+pub fn hidden(home: &Path) -> std::collections::BTreeSet<String> {
+    let mut ids = std::collections::BTreeSet::new();
+    let Ok(entries) = fs::read_dir(home.join(SESSION_HIDDEN)) else {
+        return ids;
+    };
+    for path in entries.flatten().map(|e| e.path()) {
+        let Some(name) = path.file_name().and_then(|n| n.to_str()) else {
+            continue;
+        };
+        // `<id>.<pid>.tmp` is a marker being made: its game locks it before naming it `.lock`.
+        let Some((id, pid)) = name
+            .strip_suffix(".lock")
+            .and_then(|stem| stem.rsplit_once('.'))
+        else {
+            continue;
+        };
+        if id.is_empty() || pid.parse::<u32>().is_err() {
+            continue;
+        }
+        let Ok(file) = fs::File::open(&path) else {
+            continue;
+        };
+        match file.try_lock_shared() {
+            Err(fs::TryLockError::WouldBlock) => {
+                ids.insert(id.to_owned());
+            }
+            Ok(()) => {
+                drop(file);
+                let _ = fs::remove_file(&path);
+            }
+            Err(fs::TryLockError::Error(_)) => {}
+        }
+    }
+    ids
+}
