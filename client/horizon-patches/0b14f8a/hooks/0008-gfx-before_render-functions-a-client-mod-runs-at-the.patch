From da088965993dfaf527da930efcdafdc5a72de786 Mon Sep 17 00:00:00 2001
From: pointofpressure <pointofpressure@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:28:35 +0000
Subject: [PATCH 08/10] gfx: before_render, functions a client mod runs at the
 start of each frame

Renderer::render calls them (up to four, in order) after the lost-device check, before anything of the
frame is drawn, with the renderer and the frame: for a mod's own passes such as a sky. render's body
reaches gfx's private child modules, so a function replacement of it can't be built; this is a plain hook.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/horizon-client-render/src/gfx.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/crates/horizon-client-render/src/gfx.rs b/crates/horizon-client-render/src/gfx.rs
index 1ea80d4be9..018d49fa8e 100644
--- a/crates/horizon-client-render/src/gfx.rs
+++ b/crates/horizon-client-render/src/gfx.rs
@@ -1098,6 +1098,15 @@ impl ShrinkGate {
         left == COMPACT_BUDGET && self.0.is_none_or(|at| now >= at)
     }
 }
+/// Process-wide functions a client mod runs at the start of every [`Renderer::render`] (after the lost-device check,
+/// before anything of the frame is drawn or uploaded), in the order installed: to prepare its own passes, such as a
+/// sky, against this frame.
+static BEFORE_RENDER: [std::sync::OnceLock<fn(&mut Renderer, &Frame<'_>)>; 4] =
+    [const { std::sync::OnceLock::new() }; 4];
+/// Installs one of [`BEFORE_RENDER`] for the rest of the process; false when all are taken.
+pub fn before_render(prepare: fn(&mut Renderer, &Frame<'_>)) -> bool {
+    BEFORE_RENDER.iter().any(|slot| slot.set(prepare).is_ok())
+}
 pub struct Frame<'a> {
     pub camera: DVec3,
     pub yaw: f32,
@@ -7032,6 +7041,9 @@ impl Renderer {
         if self.device_lost() {
             return Err("the graphics device was lost".into());
         }
+        for prepare in BEFORE_RENDER.iter().map_while(|slot| slot.get()) {
+            prepare(self, frame);
+        }
         if let Some(request) = self.capture.take() {
             let result = self.write_capture(&request, frame);
             self.capture_result = Some(result.map_err(|e| e.to_string()));
-- 
