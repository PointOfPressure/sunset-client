// Sunset Presence dashboard: private aggregate stats. Every request (page and API) needs the DASH_PASSWORD secret
// (HTTP Basic auth, any username); without it set the Worker answers 401 to everyone.
// Secrets: DASH_PASSWORD, AE_TOKEN (API token, Account Analytics: Read), ACCOUNT_ID. See ../README.md.
{
  "name": "sunset-presence-dash",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "INGEST", "service": "sunset-presence" }]
}
