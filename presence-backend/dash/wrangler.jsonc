// Sunset Presence dashboard: private aggregate stats. Every request (page and API) must carry a valid Cloudflare Access
// token for this app (ACCESS_TEAM, ACCESS_AUD); without them configured it answers 403 to everyone.
// Secrets: AE_TOKEN (API token, Account Analytics: Read), ACCOUNT_ID. See ../README.md.
{
  "name": "sunset-presence-dash",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "ACCESS_TEAM": "s4yerh4rris0n",
    "ACCESS_AUD": "9c9711278fde2bc635cb435d476138c647201ec15c57e7cede8328c04475b26c",
    "INGEST_URL": "https://sunset-presence.s4yerh4rris0n.workers.dev"
  }
}
